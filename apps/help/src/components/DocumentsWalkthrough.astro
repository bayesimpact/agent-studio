---
/**
 * Documents walkthrough — v3 LIVE. Mounts the REAL studioRoutes app once (shared engine) and
 * drives it through the 8-step flow — zero drift, since it uses the app's own components, labels
 * and state (see `src/walkthroughs/DocumentsLive.tsx` + `apps/help/CLAUDE.md`). Heavier than the
 * v2 static island (loads the app chunk async) but always faithful. `.wt-scope` product tokens
 * come from `global.css` (imported by BaseLayout). Pass `lang="fr"` for the French copy.
 */
import DocumentsWalkthroughIsland from "@/walkthroughs/DocumentsLive.tsx"
type Lang = "en" | "fr"
const { lang = "en" } = Astro.props as { lang?: Lang }
---

<div class="wt-embed">
  <DocumentsWalkthroughIsland client:only="react" lang={lang}>
    <div slot="fallback" class="wt-embed-loading">
      {lang === "fr" ? "Chargement de la démonstration…" : "Loading the walkthrough…"}
    </div>
  </DocumentsWalkthroughIsland>
</div>
