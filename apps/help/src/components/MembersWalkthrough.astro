---
/**
 * Workspace Members walkthrough (the `add-an-admin` guide) — v3 LIVE. Mounts the REAL
 * studioRoutes app once (shared engine) and drives it through the guide's 8 steps — zero drift,
 * since it uses the app's own components, labels and state (see `src/walkthroughs/AddAdminLive.tsx`
 * + `apps/help/CLAUDE.md`). Heavier than the v2 static island (loads the app chunk async) but
 * always faithful. `.wt-scope` product tokens come from `global.css`. Pass `lang="fr"` for French.
 */
import MembersWalkthroughIsland from "@/walkthroughs/AddAdminLive.tsx"
type Lang = "en" | "fr"
const { lang = "en" } = Astro.props as { lang?: Lang }
---

<div class="wt-embed">
  <MembersWalkthroughIsland client:only="react" lang={lang}>
    <div slot="fallback" class="wt-embed-loading">
      {lang === "fr" ? "Chargement de la démonstration…" : "Loading the walkthrough…"}
    </div>
  </MembersWalkthroughIsland>
</div>
