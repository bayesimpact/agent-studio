---
/**
 * Resource libraries walkthrough — v3 LIVE. Mounts the REAL studioRoutes app once (shared engine)
 * and drives the resource-libraries flow — zero drift (real components, labels, states). See
 * `src/walkthroughs/ResourceLibrariesLive.tsx` + `apps/help/CLAUDE.md`. `.wt-scope` product tokens
 * come from `global.css`. Pass `lang="fr"` for the French copy.
 */
import ResourceLibrariesWalkthroughIsland from "@/walkthroughs/ResourceLibrariesLive.tsx"
type Lang = "en" | "fr"
const { lang = "en" } = Astro.props as { lang?: Lang }
---

<div class="wt-embed">
  <ResourceLibrariesWalkthroughIsland client:only="react" lang={lang}>
    <div slot="fallback" class="wt-embed-loading">
      {lang === "fr" ? "Chargement de la démonstration…" : "Loading the walkthrough…"}
    </div>
  </ResourceLibrariesWalkthroughIsland>
</div>
